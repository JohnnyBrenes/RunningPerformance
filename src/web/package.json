{
  "name": "running-performance-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "22.15.1",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi --input ./openapi/running-performance.json --output ./src/api/generated --client fetch --useOptions --useUnionTypes",
    "build": "npm run generate:api && tsc -b && vite build",
    "lint": "npm run generate:api && tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "db:start": "supabase --workdir ../.. start",
    "db:repair": "supabase --workdir ../.. stop --yes && supabase --workdir ../.. start",
    "db:stop": "supabase --workdir ../.. stop --no-backup",
    "db:reset": "supabase --workdir ../.. db reset",
    "db:lint": "supabase --workdir ../.. db lint --schema app --level error",
    "db:test": "supabase --workdir ../.. test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "react-is": "19.2.8",
    "react-router": "7.18.2",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "openapi-typescript-codegen": "0.31.0",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
