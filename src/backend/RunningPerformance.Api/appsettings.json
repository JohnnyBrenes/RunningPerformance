{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "AnonymousPermitLimit": 30,
    "AuthenticatedPermitLimit": 120
  },
  "FreeTier": {
    "DatabaseWarningMb": 300,
    "DatabaseBlockMb": 400,
    "StorageWarningMb": 700,
    "StorageBlockMb": 850
  },
  "HistoricalImport": {
    "ExpectedRowCount": 460,
    "MaxCsvBytes": 5242880,
    "LeaseSeconds": 120,
    "PollSeconds": 5,
    "MaxAttempts": 3
  },
  "FitIngestion": {
    "MaxFitBytes": 52428800,
    "LeaseSeconds": 180,
    "MaxAttempts": 3,
    "SampleBatchSize": 500,
    "PairingMinutes": 10,
    "CredentialDays": 90
  }
}
