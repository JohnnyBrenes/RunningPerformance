    },
    {
      "name": "backend",
      "technology": ["ASP.NET Core", ".NET 10 LTS", "Npgsql", "Garmin.FIT.Sdk"],
      "hosting": "Render_Free_single_Docker_web_service",
      "logicalComponents": ["REST_API", "hosted_BackgroundService_worker"],
      "responsibilities": ["authentication_validation", "authorization", "domain_API", "uploads", "commands", "queries", "csv_import", "fit_processing", "reprocessing", "weekly_snapshots", "exports", "reconciliation"]
    }
  ],
  "managedServices": [
    {"name": "auth", "provider": "Supabase Auth Free", "access": "web_for_session_and_api_for_verification"},
    {"name": "database", "provider": "Supabase PostgreSQL Free", "access": "api_and_worker_through_dedicated_postgres_roles"},
    {"name": "objectStorage", "provider": "Supabase Storage Free", "access": "private_backend_managed_objects"}
  ],
  "repository": {
    "publishableRoot": "App/",
    "web": "src/web",
    "backendSolution": "src/backend",
    "backendProjects": [
      "RunningPerformance.Api",
      "RunningPerformance.Worker",
      "RunningPerformance.Application",
      "RunningPerformance.Domain",
      "RunningPerformance.Infrastructure",
      "RunningPerformance.Fit"
    ],
    "database": "supabase/migrations",
    "databaseTests": "supabase/tests/database",
    "realDataAllowed": false,
    "githubActionsEnabled": false,
    "verificationMode": "local_only"
  },
  "frontend": {
    "directSupabaseUse": ["authentication_only"],
    "domainAccess": "versioned_dotnet_REST_API",
    "serverSideOperations": ["filtering", "sorting", "cursor_pagination", "aggregations"],
    "apiClient": "generated_from_OpenAPI",
    "routeCodeSplitting": true,
    "targetClients": {
      "mobile": "Safari on the two major iOS versions currently supported by Apple",
      "desktop": "current Chrome and Edge on PC",
      "minimumViewportCssPx": 320,
      "minimumTouchTargetCssPx": 44,
      "minimumInputFontCssPxOnIos": 16,
      "safeAreaInsets": true,
      "primaryFlowHorizontalLayoutScroll": false,
      "manualUpload": ["iOS Files or Share Sheet", "PC file picker or drag and drop"],
      "installableWebAppRequired": true,
      "webAppManifestRequired": true,
      "standaloneDisplayRequired": true,
      "serviceWorkerRequired": false,
      "offlineRequired": false
    },
    "exerciseAssets": {
      "location": "versioned_frontend_assets",
      "personalData": false,
      "databaseStores": ["uri", "position", "alt_text", "source", "license", "optional_sha256"]
    }
  },
  "webAuthentication": {
    "provider": "Supabase Auth",
    "identifier": "email",
    "credential": "password",
    "publicRegistration": false,
    "browserSession": "official_supabase_js_session_management",
    "apiTransport": "Authorization_Bearer_access_token",
    "apiValidation": ["signature", "issuer", "audience", "expiration", "subject", "authenticated_role"],
    "signingKeyDiscovery": "project_JWKS_endpoint",
    "ownerSource": "verified_sub_claim",
    "customJWT": false,
    "futureHardening": "BFF_with_HttpOnly_cookie_if_risk_profile_changes"
  },
  "synchronizerAuthentication": {
    "usesWebPassword": false,
    "usesWebRefreshToken": false,
    "pairingAuthorizedBy": "authenticated_web_session",
    "pairingTokenMaximumMinutes": 10,
    "deviceSecretBits": 256,
    "deviceCredentialMaximumDays": 90,
    "scope": "fit.upload",
    "readAccess": false,
    "serverSecretStorage": "peppered_hash_only",
    "windowsSecretStorage": "Windows Credential Manager",
    "revocable": true,
    "tables": ["sync_pairing_tokens", "sync_clients"]
  },
  "api": {
    "protocol": "REST_JSON_and_streaming_multipart",
    "prefix": "/api/v1",
    "errors": "RFC_ProblemDetails_with_stable_code_and_correlation_id",
    "defaultAuthorization": "authenticated",
    "identityFromRouteOrBody": false,
    "idempotencyRequiredFor": ["file_upload", "plan_publish", "weekly_decision", "export"],
    "pagination": "stable_cursor",
    "productionInteractiveOpenApi": false,
    "health": ["/health/live", "/health/ready"]
  },
  "database": {
    "domainSchema": "app_not_exposed_by_Data_API",
    "schemaAuthority": "versioned_SQL_migrations_with_Supabase_CLI",
    "ormMigrationAuthority": false,
    "runtimeLibrary": "Npgsql_with_explicit_SQL_and_optional_lightweight_mapping",
    "apiLoginRole": "rp_api_login_without_bypassrls",
    "workerLoginRole": "rp_worker_login_with_narrow_ingestion_grants",
    "rlsPredicate": "owner_id_equals_auth_uid",
    "requestContext": "SET_LOCAL_verified_request_jwt_claim_sub_and_claims_inside_every_transaction",
    "poolContextLeakTestRequired": true,
    "serviceRoleForDomainQueries": false,
    "connection": {
      "persistentIpv6": "direct_connection",
      "persistentIpv4": "Supavisor_session_mode",
      "serverlessFuture": "transaction_pooler_with_prepared_statements_disabled"
    }
  },
  "storage": {
    "bucket": "athlete-files",
    "public": false,
    "pathTemplate": "owner_id/source_kind/source_file_id/safe_file_name",
    "clientSuppliedPathAccepted": false,
    "upsertOriginalAllowed": false,
    "uploadPath": "client_to_API_stream_to_private_storage",
    "download": "authenticated_API_stream_or_short_signed_URL",
    "permanentPublicUrl": false,
    "databaseBinary": false
  },
  "jobs": {
    "queue": "PostgreSQL_ingestion_runs",
    "productionExecution": "BackgroundService_hosted_inside_API_process",
    "separateWorkerDeployment": false,
    "localHost": "RunningPerformance.Worker_console_host",
    "externalBroker": false,
    "claim": "FOR_UPDATE_SKIP_LOCKED_with_expiring_lease",
    "recovery": ["heartbeat", "attempt_count", "next_attempt_at", "expired_lease_requeue"],
    "transientFailure": "bounded_retry_with_backoff",
    "integrityOrIdentityFailure": "quarantine",
    "csvCommit": "validate_all_460_items_then_single_transaction",
    "fitCommit": "one_activity_and_all_detail_in_single_transaction",
    "weeklyDecisionAutomaticPublish": false,
    "freeServiceBehavior": {
      "idleSpinDownMinutes": 15,
      "coldStartApproximatelySeconds": 60,
      "spaPollsPendingJobs": true,
      "jobProcessingInsideHttpRequest": false,
      "expiredLeaseRecoveredOnNextWake": true,
      "eventualProcessingAccepted": true,
      "artificialKeepAliveAllowed": false
    }
  },
  "fit": {
    "implementation": "extract_Tools_FitProcessor_core_into_RunningPerformance.Fit_library",
    "validation": ["signature", "declared_size", "CRC_integrity", "SDK_full_read", "SHA256", "identity_collision"],
    "originalImmutable": true,
    "normalized": ["activity_fit_sessions", "activity_laps", "activity_events", "activity_time_in_zones", "activity_samples"],
    "requestThreadProcessing": false
